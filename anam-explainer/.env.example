# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Anam (required): the avatar/token key. Stays server-side; only a session token reaches the browser.
ANAM_API_KEY=your_anam_api_key_here

# Optional: override the persona voice (an Anam voiceId). Default is a premium British studio voice
# ("Alexander Kensington"). Browse with `node tools/list_voices.mjs [search] [gender] [country]`.
# ANAM_VOICE_ID=9c39154a-5477-5967-8dfd-90fe7a5c543f

# --- Our MutationScientist model backend (pick ONE path) ---------------------------------
# Path A: OpenAI-compatible endpoint (e.g. local MLX/vLLM serving Qwen3.5-4B + MutationScientist LoRA).
#   If set, this wins. Defaults to http://localhost:8000/v1 when nothing below is configured.
MODEL_BASE_URL=http://localhost:8000/v1
# MODEL_API_KEY=            # optional; usually unset for local MLX/vLLM
# MODEL_NAME=               # optional; auto-discovers the fine-tune from {MODEL_BASE_URL}/models
# MODEL_MAX_TOKENS=512      # optional
# MODEL_ENABLE_THINKING=0   # 1 re-enables Qwen3 thinking (default off; reasoning is never spoken)

# Path B: Adaption Inference Stack (Responses API). Used only if MODEL_BASE_URL is NOT set.
#   Create the stack in the Adaption web UI, select the fine-tuned run, copy its slug.
# ADAPTION_STACK=your_stack_slug
# ADAPTION_API_KEY=pt_live_...
# ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai   # optional override

# --- Optional: ElevenLabs Creator voice import (tools/import_voice.mjs, route C) ----------
#   Only needed to use YOUR specific ElevenLabs voice (the default voice is already ElevenLabs-backed).
#   Requires Anam custom-voice access on your org.
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# optional: PORT=3000

# Copy to .env (gitignored) to wire the real integrations. ./run.sh auto-loads it,
# so a restart keeps the app fully live. Mock/template is used for anything unset.
# No secrets belong in .env.example — only placeholders.

# --- Real Boltz-2 predictions (Terminal 2) --------------------------------
# JSON list or {complex_id: record}; pairs without a record stay MOCK (honest).
BOLTZ_PREDICTIONS_PATH=/absolute/path/to/boltz_predictions.json

# --- Fine-tuned MutationScientist LLM, OpenAI-compatible (Terminal 1) ------
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=x                      # any non-empty string for the local server
OPENAI_MODEL=/absolute/path/to/mlx_model

# --- OR the Adaption hosted stack (takes precedence over OPENAI_* if set) ---
# ADAPTION_API_KEY=pt_live_...
# ADAPTION_STACK=your-stack-slug

# --- Optional live evidence retrieval API (Terminal 5) --------------------
# When set, EvidenceService queries it and falls back to curated+cited on error.
# EVIDENCE_API_URL=http://localhost:PORT/evidence
